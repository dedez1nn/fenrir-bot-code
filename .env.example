## ─── Discord Bot ──────────────────────────────────────────────────────────────
TOKEN=
ACCESS_TOKEN=
# ID da guild principal — usado para carregar server_config no boot
GUILD_ID=

ENVIRONMENT=development
LOG_LEVEL=INFO

## ─── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_DB=fenrir
POSTGRES_USER=fenrir
POSTGRES_PASSWORD=
# Formato: postgresql://USER:SENHA@HOST:5432/DB
#   - docker-compose:            HOST = postgres (nome do serviço)
#   - dev local:                 HOST = localhost
#   - templates separados (VPS): HOST = IP privado do container/VM do Postgres
#                                (ex.: 10.0.0.5) — nunca o IP público.
DATABASE_URL=postgresql://fenrir:senha@10.0.0.5:5432/fenrir

## ─── API / Painel admin (Fase 5) ──────────────────────────────────────────────
API_PORT=8000
# Discord OAuth2 (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/auth/callback
# Segredo para assinar JWT da sessão do painel (gere com `openssl rand -hex 32`)
# ATENÇÃO: enquanto JWT_SECRET não for alterado do padrão, auth é dispensada em dev.
JWT_SECRET=change-me-in-production
# IDs de cargo (CSV) que têm acesso ao painel — vazio = qualquer membro da guild
ADMIN_ROLE_IDS=
# Segredo HMAC do webhook do Mercado Pago
# Configure em MP: Dashboard → Sua aplicação → Webhooks → Chave secreta
MP_WEBHOOK_SECRET=
# Origens permitidas (CSV) — em produção, restrinja ao domínio do painel
CORS_ORIGINS=*

## ─── Riot Games API ──────────────────────────────────────────────────────────
# Obtenha em: https://developer.riotgames.com
RIOT_API_KEY=
RIOT_REGION=br1

## ─── Steam API ───────────────────────────────────────────────────────────────
# Obtenha em: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

## ─── GNews API ───────────────────────────────────────────────────────────────
# Obtenha em: https://gnews.io
GNEWS_API_KEY=

## ─── Painel local de cogs (somente desenvolvimento) ──────────────────────────
# 1 = sobe um painel em http://localhost:<porta> para ligar/desligar cogs em tempo real.
# Preso a 127.0.0.1 e protegido por token. Deixe desligado em produção (Discloud).
DEV_PANEL=0
DEV_PANEL_PORT=8765
# 1 = sincroniza os slash commands sozinho (com atraso) depois de ligar/desligar cogs
DEV_PANEL_AUTOSYNC=1
